# Build-time (Vite inlines these into the client bundle — they must be present
# when `bun run build` runs, locally and in CI):
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publi…_...

# Runtime (Cloudflare Worker Variables and Secrets for the Worker being
# deployed — `yomionalaru-v2-staging` and `yomionalaru`):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publi…_...
SUPABASE_SERVICE_ROLE_KEY=***

# In GitHub Actions the two VITE_ values come from repository secrets named
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY. The three runtime values
# are set on the Worker itself (Cloudflare dashboard, or `wrangler secret put`
# for the service-role key).
